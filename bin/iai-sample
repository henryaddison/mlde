#! /bin/bash

#SBATCH --gpus=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=16G
#SBATCH --time=1-00:00:00

set -euo pipefail

checkpoint=$1
workdir=$2
dataset=$3
nsamples=${4:-1}
split=${5:-test}

batch_size=366

hostname
nvidia-smi

pixi run python bin/predict.py --checkpoint ${checkpoint} --num-samples ${nsamples} --dataset ${dataset} --split ${split} --batch-size ${batch_size}  ${workdir}
